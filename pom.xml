<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.ee4j</groupId>
        <artifactId>project</artifactId>
        <version>2.0.2</version>
        <relativePath/>
    </parent>

    <groupId>jakarta.agentic-ai</groupId>
    <artifactId>jakarta.agentic-ai-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Jakarta Agentic AI Parent</name>
    <description>Parent build for Jakarta Agentic AI modules.</description>
    <url>https://github.com/jakartaee/agentic-ai</url>

    <modules>
        <module>api</module>
        <module>spec</module>
        <module>tck</module>
        <module>examples</module>
    </modules>

    <!--
        The published code artifacts (api, tck) are EPL-2.0, matching the LICENSE
        and NOTICE files at the root of the repository and the SPDX headers on
        every source file. The Eclipse Foundation Specification License covers the
        specification document instead, and is declared by the spec module.
    -->
    <licenses>
        <license>
            <name>Eclipse Public License 2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git://github.com/jakartaee/agentic-ai.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/jakartaee/agentic-ai.git</developerConnection>
        <url>https://github.com/jakartaee/agentic-ai</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/jakartaee/agentic-ai/issues</url>
    </issueManagement>

    <developers>
        <developer>
            <name>Jakarta Agentic AI Developers</name>
            <email>agentic-ai-dev@eclipse.org</email>
            <organization>Eclipse Foundation</organization>
            <organizationUrl>https://www.eclipse.org</organizationUrl>
        </developer>
    </developers>

    <properties>
        <!-- Java SE 17 baseline. This is the only place the language level is set. -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Jakarta EE 10 baseline. Modules depend on the platform umbrella
             (jakarta.platform:jakarta.jakartaee-api) rather than on individual
             Jakarta APIs, so this single version governs the whole EE surface
             and no module can drift to a different API level. -->
        <jakarta.ee.version>10.0.0</jakarta.ee.version>
        <cyclonedx.skip>true</cyclonedx.skip>
        <spec.version>1.0</spec.version>
        <!-- set to false for release -->
        <spec.nonFinal>true</spec.nonFinal>
        <!-- Draft | Final Release -->
        <spec.status>Draft</spec.status>
        <nexus.staging.repository>agentic-ai-maven2-staging</nexus.staging.repository>
        <project.build.outputTimestamp>2026-07-28T01:22:11Z</project.build.outputTimestamp>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- The Jakarta EE 10 platform. Every module that needs a Jakarta API
                 declares this one dependency and inherits the whole EE 10 surface
                 at a consistent level; individual Jakarta APIs are not declared. -->
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-api</artifactId>
                <version>${jakarta.ee.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java-se-baseline</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                    <message>Jakarta Agentic AI requires Java SE 17 or newer.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
